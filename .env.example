NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Server-only. Single-user mode uses this to act on your behalf — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# The one Supabase auth user everything in the app is owned by.
# Dashboard → Authentication → Users → Add user → copy the UID here.
# No login screen exists; this is set once and never touched again.
KEEYSTAY_OWNER_ID=<uuid-of-your-one-user>

NEXT_PUBLIC_TZ=Asia/Kolkata
